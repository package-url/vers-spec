{
  "$schema": "https://packageurl.org/schemas/vers-type-definition.schema-0.2.json",
  "$id": "https://packageurl.org/vers-types/npm-definition.json",
  "type": "npm",
  "type_name": "npm versioning",
  "description": "npm versioning version ranges.",
  "vers_examples": [
    "vers:npm/>=1.2.0|<1.3.0",
    "vers:npm/>=1.1.0|<=2.1.0",
    "vers:npm/>=0.0.2-beta|<0.0.3",
    "vers:npm/<1.4.1|>=2.0.0|<2.17.2",
    "vers:npm/>=2.0.0-alpha8|<=2.0.0-rc2|>=2.0.0|<=2.13.0",
    "vers:npm/>=2.2.6|<2.47.0|>2.51.0|<=2.67.0",
    "vers:npm/>=1.7.0|<1.7.16|>=1.8.0|<1.8.8|>=2.0.0|<2.0.8|>=3.0.0-beta.1|<3.0.0-beta.7"
  ],
  "native_range_and_vers_equivalent_examples": [
    {
      "native_range": "^1.1.7 || >= 2.0.1",
      "vers": "vers:npm/>=1.1.7|<2.0.0|>=2.0.1"
    },
    {
      "native_range": "~1.6.5 || >=1.7.2",
      "vers": "vers:npm/>=1.6.5|<1.7.0|>=1.7.2"
    },
    {
      "native_range": "*",
      "vers": "vers:npm/*"
    },
    {
      "native_range": "2.1.4",
      "vers": "vers:npm/2.1.4"
    },
    {
      "native_range": ">=2.0.0 <=4.0.4",
      "vers": "vers:npm/>=2.0.0|<=4.0.4"
    },
    {
      "native_range": ">= 2.2.x",
      "vers": "vers:npm/>=2.2.0|<2.3.0"
    },
    {
      "native_range": "2.0.x || 2.1.x",
      "vers": "vers:npm/>=2.0.0|<2.1.0|>=2.1.0|<2.2.0"
    },
    {
      "native_range": "=3.0.0-rc.1",
      "vers": "vers:npm/3.0.0-rc.1"
    }
  ],
  "reference_urls": [
    "https://github.com/npm/node-semver#ranges"
  ]
}
