{
  "$schema": "https://packageurl.org/schemas/vers-test.schema-0.2.json",
  "tests": [
    {
      "description": "Test version containment for npm range with `*` operator.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:npm/*",
        "version": "1.0.0"
      },
      "expected_output": true
    },
    {
      "description": "Test version containment for npm range with a single `>=` bound.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:npm/>=1.0.0",
        "version": "2.0.0"
      },
      "expected_output": true
    },
    {
      "description": "Test version containment for npm range with a single `>=` bound.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:npm/>=1.0.0",
        "version": "1.0.0"
      },
      "expected_output": true
    },
    {
      "description": "Test version containment for npm range with a single `>=` bound.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:npm/>=1.0.0",
        "version": "0.9.0"
      },
      "expected_output": false
    },
    {
      "description": "Test version containment for npm range with a single `>` bound.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:npm/>1.0.0",
        "version": "1.0.1"
      },
      "expected_output": true
    },
    {
      "description": "Test version containment for npm range with a single `>` bound.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:npm/>1.0.0",
        "version": "1.0.0"
      },
      "expected_output": false
    },
    {
      "description": "Test version containment for npm range with a single `>` bound.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:npm/>1.0.0",
        "version": "0.9.0"
      },
      "expected_output": false
    },
    {
      "description": "Test version containment for npm range with a single `<` bound.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:npm/<2.0.0",
        "version": "1.0.0"
      },
      "expected_output": true
    },
    {
      "description": "Test version containment for npm range with a single `<` bound.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:npm/<2.0.0",
        "version": "2.0.0"
      },
      "expected_output": false
    },
    {
      "description": "Test version containment for npm range with a single `<` bound.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:npm/<2.0.0",
        "version": "3.0.0"
      },
      "expected_output": false
    },
    {
      "description": "Test version containment for npm range with a single `<=` bound.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:npm/<=2.0.0",
        "version": "1.9.9"
      },
      "expected_output": true
    },
    {
      "description": "Test version containment for npm range with a single `<=` bound.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:npm/<=2.0.0",
        "version": "2.0.0"
      },
      "expected_output": true
    },
    {
      "description": "Test version containment for npm range with a single `<=` bound.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:npm/<=2.0.0",
        "version": "2.0.1"
      },
      "expected_output": false
    },
    {
      "description": "Test version containment for npm range with a single `>=` bound.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:npm/>=1.0.0|!=1.5.0",
        "version": "2.0.0"
      },
      "expected_output": true
    },
    {
      "description": "Test version containment for npm range with a single `>=` bound.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:npm/>=1.0.0|!=1.5.0",
        "version": "1.5.0"
      },
      "expected_output": false
    },
    {
      "description": "Test version containment for npm range with a single `>=` bound.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:npm/1.0.0|>=2.0.0",
        "version": "3.0.0"
      },
      "expected_output": true
    },
    {
      "description": "Test version containment for npm range with a single `>=` bound.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:npm/1.0.0|>=2.0.0",
        "version": "1.0.0"
      },
      "expected_output": true
    },
    {
      "description": "Test version containment for npm range with a single `>=` bound.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:npm/1.0.0|>=2.0.0",
        "version": "1.5.0"
      },
      "expected_output": false
    },
    {
      "description": "Test version containment for npm range with a single `<` bound.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:npm/<1.0.0|2.0.0",
        "version": "0.5.0"
      },
      "expected_output": true
    },
    {
      "description": "Test version containment for npm range with a single `<` bound.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:npm/<1.0.0|2.0.0",
        "version": "2.0.0"
      },
      "expected_output": true
    },
    {
      "description": "Test version containment for npm range with a single `<` bound.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:npm/<1.0.0|2.0.0",
        "version": "1.5.0"
      },
      "expected_output": false
    },
    {
      "description": "Test version containment for npm range with a single `<` bound.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:npm/<1.0.0|2.0.0",
        "version": "3.0.0"
      },
      "expected_output": false
    }
  ]
}
